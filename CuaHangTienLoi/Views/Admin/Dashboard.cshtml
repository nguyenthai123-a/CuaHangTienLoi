@model CuaHangTienLoi.Models.DashboardStatsViewModel
@{
    ViewData["Title"] = "Bảng điều khiển Quản trị";
    ViewBag.ActiveMenu = "Dashboard";
}

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-xl-3 col-sm-6">
        <div class="card shadow-sm border-0 border-start border-primary border-4">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <small class="text-muted text-uppercase fw-bold" style="font-size: 0.75rem;">Doanh thu hôm nay</small>
                        <h4 class="fw-bold mb-0 text-primary mt-1">@Model.DoanhThuHomNay.ToString("N0")đ</h4>
                    </div>
                    <div class="bg-primary-subtle text-primary rounded-circle p-3">
                        <i class="fa-solid fa-sack-dollar fa-xl"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="card shadow-sm border-0 border-start border-success border-4">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <small class="text-muted text-uppercase fw-bold" style="font-size: 0.75rem;">Đơn hàng hôm nay</small>
                        <h4 class="fw-bold mb-0 text-success mt-1">@Model.SoDonHangHomNay</h4>
                    </div>
                    <div class="bg-success-subtle text-success rounded-circle p-3">
                        <i class="fa-solid fa-receipt fa-xl"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="card shadow-sm border-0 border-start border-danger border-4">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <small class="text-muted text-uppercase fw-bold" style="font-size: 0.75rem;">Hàng sắp hết hạn (FEFO)</small>
                        <h4 class="fw-bold mb-0 text-danger mt-1">@Model.SoHangSapHetHan lô</h4>
                    </div>
                    <div class="bg-danger-subtle text-danger rounded-circle p-3">
                        <i class="fa-solid fa-triangle-exclamation fa-xl"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="card shadow-sm border-0 border-start border-warning border-4">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <small class="text-muted text-uppercase fw-bold" style="font-size: 0.75rem;">Đổi trả chờ duyệt</small>
                        <h4 class="fw-bold mb-0 text-warning mt-1">@Model.SoPhieuDoiTraChoDuyet</h4>
                    </div>
                    <div class="bg-warning-subtle text-warning rounded-circle p-3">
                        <i class="fa-solid fa-rotate-left fa-xl"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Chart & Alerts Row -->
<div class="row g-4 mb-4">
    <!-- Chart: Doanh thu 7 ngày -->
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold text-dark"><i class="fa-solid fa-chart-area me-2 text-primary"></i> Xu Hướng Doanh Thu 7 Ngày Gần Nhất</h6>
                <a asp-controller="BaoCao" asp-action="Index" class="btn btn-outline-primary btn-sm py-1">Chi tiết</a>
            </div>
            <div class="card-body p-3">
                <canvas id="revenueChart" style="max-height: 280px;"></canvas>
            </div>
        </div>
    </div>

    <!-- Quick shift & low stock status -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold text-dark"><i class="fa-solid fa-bell me-2 text-danger"></i> Cảnh Báo & Tình Trạng Quầy</h6>
            </div>
            <div class="card-body p-3">
                <div class="p-3 bg-light rounded mb-3 border">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="small fw-semibold">Ca thu ngân đang mở:</span>
                        <span class="badge bg-success">@Model.SoCaDangMo quầy hoạt động</span>
                    </div>
                    <div class="small text-muted">Mỗi quầy chỉ cho phép duy nhất một ca mở tại một thời điểm (UX_Ca_QuayDangMo).</div>
                </div>

                <div class="p-3 bg-light rounded border">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="small fw-semibold">Sản phẩm dưới định mức tồn:</span>
                        <span class="badge bg-warning text-dark">@Model.SoHangDuoiDinhMuc sản phẩm</span>
                    </div>
                    <div class="small text-muted">Cần chuyển thêm hàng từ kho lên quầy theo nguyên tắc FEFO.</div>
                </div>

                <div class="mt-3 text-center">
                    <a asp-controller="Kho" asp-action="XuatKho" class="btn btn-outline-primary btn-sm w-100 fw-semibold">
                        <i class="fa-solid fa-dolly me-1"></i> Bổ sung hàng lên quầy ngay
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Invoices Table -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-bold text-dark"><i class="fa-solid fa-receipt me-2 text-primary"></i> Giao Dịch Bán Hàng Mới Nhất</h6>
        <a asp-controller="BaoCao" asp-action="Index" class="small text-decoration-none">Xem toàn bộ &raquo;</a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Số HĐ</th>
                        <th>Thời Gian</th>
                        <th>Quầy</th>
                        <th>Thu Ngân</th>
                        <th>Khách Hàng</th>
                        <th class="text-end">Tổng Tiền</th>
                        <th class="text-end">Giảm Giá</th>
                        <th class="text-end">Khách Trả</th>
                        <th class="text-center pe-3">In Hóa Đơn</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.HoaDonGanDay.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">Chưa có giao dịch nào phát sinh hôm nay</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var hd in Model.HoaDonGanDay)
                        {
                            <tr>
                                <td class="ps-3 fw-bold text-primary font-monospace">@hd.SoHoaDon</td>
                                <td class="small font-monospace">@hd.NgayGio.ToString("dd/MM/yyyy HH:mm")</td>
                                <td><span class="badge bg-light text-dark border">@hd.TenQuay</span></td>
                                <td>@hd.TenThuNgan</td>
                                <td>@(string.IsNullOrEmpty(hd.TenKhachHang) ? "Khách vãng lai" : hd.TenKhachHang)</td>
                                <td class="text-end font-monospace">@hd.TongTien.ToString("N0")đ</td>
                                <td class="text-end font-monospace text-success">-@hd.GiamGia.ToString("N0")đ</td>
                                <td class="text-end font-monospace fw-bold text-dark">@hd.ThanhTien.ToString("N0")đ</td>
                                <td class="text-center pe-3">
                                    <a asp-controller="Pos" asp-action="InHoaDon" asp-route-id="@hd.MaHoaDon" target="_blank" class="btn btn-outline-secondary btn-sm py-0 px-2">
                                        <i class="fa-solid fa-print"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctx = document.getElementById('revenueChart');
        if (ctx) {
            const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DoanhThu7Ngay.Select(d => d.Ngay)));
            const data = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DoanhThu7Ngay.Select(d => d.DoanhThu)));

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels.length ? labels : ['Hôm nay'],
                    datasets: [{
                        label: 'Doanh thu (VNĐ)',
                        data: data.length ? data : [0],
                        borderColor: '#2563eb',
                        backgroundColor: 'rgba(37, 99, 235, 0.1)',
                        borderWidth: 3,
                        fill: true,
                        tension: 0.35,
                        pointRadius: 5,
                        pointBackgroundColor: '#2563eb'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    return value.toLocaleString('vi-VN') + 'đ';
                                }
                            }
                        }
                    }
                }
            });
        }
    </script>
}
