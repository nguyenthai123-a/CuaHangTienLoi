@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    var currentUser = HttpContextAccessor.HttpContext?.Session.GetObject<UserSessionModel>("CurrentUser");
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>POS Bán Hàng - Cửa Hàng Tiện Lợi 24/7</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome 6 Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/pos.css" />
</head>
<body class="pos-body bg-light overflow-hidden">
    <!-- POS Top Navigation -->
    <header class="pos-header bg-dark text-white px-3 py-2 d-flex justify-content-between align-items-center shadow-sm">
        <div class="d-flex align-items-center">
            <span class="badge bg-warning text-dark fs-6 fw-bold px-2 py-1 me-3">
                <i class="fa-solid fa-cash-register me-1"></i> POS 24/7
            </span>
            <div class="d-flex flex-column">
                <div class="fw-bold fs-6">
                    <span class="text-success"><i class="fa-solid fa-circle fa-2xs me-1"></i></span>
                    Ca #@currentUser?.CurrentMaCa: @currentUser?.CurrentTenQuay
                </div>
                <small class="text-secondary" style="font-size: 0.72rem;">
                    Thu ngân: <strong>@currentUser?.HoTen</strong> (@currentUser?.TenDangNhap)
                </small>
            </div>
        </div>

        <div class="d-flex align-items-center gap-3">
            <!-- Đồng hồ thời gian thực -->
            <div class="text-end d-none d-md-block">
                <div id="liveClock" class="fw-bold text-warning font-monospace fs-5 lh-1">--:--:--</div>
                <small class="text-secondary" id="liveDate" style="font-size: 0.72rem;">--/--/----</small>
            </div>

            <!-- Các phím tắt hướng dẫn -->
            <button type="button" class="btn btn-outline-light btn-sm" data-bs-toggle="modal" data-bs-target="#shortcutModal" title="Phím tắt">
                <i class="fa-solid fa-keyboard me-1"></i> <span class="d-none d-sm-inline">Phím tắt</span>
            </button>

            <!-- Nút đóng ca -->
            <a asp-controller="Ca" asp-action="DongCa" class="btn btn-outline-warning btn-sm fw-semibold" title="Đóng ca & Kết toán tiền">
                <i class="fa-solid fa-door-closed me-1"></i> <span class="d-none d-sm-inline">Đóng ca</span>
            </a>

            <!-- Nút về trang chủ / Dashboard -->
            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary btn-sm" title="Quay lại">
                <i class="fa-solid fa-house"></i>
            </a>
        </div>
    </header>

    <!-- POS Main Container -->
    <main class="pos-main-container">
        @RenderBody()
    </main>

    <!-- Modal Hướng dẫn phím tắt -->
    <div class="modal fade" id="shortcutModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow border-0">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title"><i class="fa-solid fa-keyboard me-2"></i> Phím Tắt Thao Tác Nhanh POS</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>Tìm kiếm / Quét mã vạch</span>
                            <kbd class="bg-dark text-white px-2 py-1">F2 hoặc /</kbd>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>Tìm khách hàng (Số điện thoại)</span>
                            <kbd class="bg-dark text-white px-2 py-1">F4</kbd>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>Thanh toán Tiền mặt nhanh</span>
                            <kbd class="bg-success text-white px-2 py-1">F8</kbd>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>Thanh toán Chuyển khoản QR</span>
                            <kbd class="bg-primary text-white px-2 py-1">F9</kbd>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>Thanh toán Thẻ ngân hàng</span>
                            <kbd class="bg-info text-white px-2 py-1">F10</kbd>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>Xóa sạch giỏ hàng hiện tại</span>
                            <kbd class="bg-danger text-white px-2 py-1">Esc</kbd>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Đồng hồ thời gian thực
        function updateClock() {
            const now = new Date();
            const timeStr = now.toLocaleTimeString('vi-VN', { hour12: false });
            const dateStr = now.toLocaleDateString('vi-VN', { weekday: 'short', day: '2-digit', month: '2-digit', year: 'numeric' });
            const clockEl = document.getElementById('liveClock');
            const dateEl = document.getElementById('liveDate');
            if (clockEl) clockEl.innerText = timeStr;
            if (dateEl) dateEl.innerText = dateStr;
        }
        setInterval(updateClock, 1000);
        updateClock();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
