@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    var currentUser = HttpContextAccessor.HttpContext?.Session.GetObject<UserSessionModel>("CurrentUser");
    string activeMenu = ViewBag.ActiveMenu as string ?? "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cửa Hàng Tiện Lợi 24/7</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome 6 Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Custom site css -->
    <link rel="stylesheet" href="~/css/site.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="d-flex" id="wrapper">
        <!-- Sidebar Navigation -->
        <div class="sidebar border-end bg-dark text-white" id="sidebar-wrapper">
            <div class="sidebar-heading border-bottom bg-primary text-white py-3 px-4 d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                    <i class="fa-solid fa-store fa-xl me-2 text-warning"></i>
                    <div>
                        <div class="fw-bold fs-6">TIỆN LỢI 24/7</div>
                        <small class="text-white-50" style="font-size: 0.72rem;">Hệ Thống Bán Lẻ & Kho</small>
                    </div>
                </div>
            </div>

            <div class="list-group list-group-flush my-2">
                @if (currentUser?.MaVaiTro == "QUAN_LY")
                {
                    <div class="sidebar-category">QUẢN TRỊ VIÊN</div>
                    <a class="list-group-item list-group-item-action @(activeMenu == "Dashboard" ? "active" : "")" asp-controller="Admin" asp-action="Dashboard">
                        <i class="fa-solid fa-chart-line me-2"></i> Bảng điều khiển
                    </a>
                    <a class="list-group-item list-group-item-action @(activeMenu == "HangHoa" ? "active" : "")" asp-controller="Admin" asp-action="HangHoa">
                        <i class="fa-solid fa-boxes-stacked me-2"></i> Quản lý Hàng hóa
                    </a>
                    <a class="list-group-item list-group-item-action @(activeMenu == "NhanVien" ? "active" : "")" asp-controller="Admin" asp-action="NhanVien">
                        <i class="fa-solid fa-users-gear me-2"></i> Nhân viên & Tài khoản
                    </a>
                    <a class="list-group-item list-group-item-action @(activeMenu == "KhuyenMai" ? "active" : "")" asp-controller="Admin" asp-action="KhuyenMai">
                        <i class="fa-solid fa-tags me-2"></i> Khuyến mãi & Giảm giá
                    </a>
                    <a class="list-group-item list-group-item-action @(activeMenu == "KhachHang" ? "active" : "")" asp-controller="Admin" asp-action="KhachHang">
                        <i class="fa-solid fa-id-card me-2"></i> Khách hàng thân thiết
                    </a>
                    <a class="list-group-item list-group-item-action @(activeMenu == "DoiTra" ? "active" : "")" asp-controller="Admin" asp-action="DoiTra">
                        <i class="fa-solid fa-rotate-left me-2"></i> Duyệt Đổi / Trả hàng
                    </a>
                    <a class="list-group-item list-group-item-action @(activeMenu == "BaoCao" ? "active" : "")" asp-controller="BaoCao" asp-action="Index">
                        <i class="fa-solid fa-file-invoice-dollar me-2"></i> Báo cáo Doanh thu
                    </a>
                    <a class="list-group-item list-group-item-action @(activeMenu == "NhatKy" ? "active" : "")" asp-controller="Admin" asp-action="NhatKyKiemToan">
                        <i class="fa-solid fa-shield-halved me-2"></i> Nhật ký kiểm toán
                    </a>
                }

                @if (currentUser?.MaVaiTro == "QUAN_LY" || currentUser?.MaVaiTro == "NHAN_VIEN_KHO")
                {
                    <div class="sidebar-category">QUẢN LÝ KHO & FEFO</div>
                    <a class="list-group-item list-group-item-action @(activeMenu == "KhoIndex" ? "active" : "")" asp-controller="Kho" asp-action="Index">
                        <i class="fa-solid fa-warehouse me-2"></i> Tồn kho & Hạn dùng (FEFO)
                    </a>
                    <a class="list-group-item list-group-item-action @(activeMenu == "NhapKho" ? "active" : "")" asp-controller="Kho" asp-action="NhapKho">
                        <i class="fa-solid fa-cart-flatbed me-2"></i> Nhập kho hàng mới
                    </a>
                    <a class="list-group-item list-group-item-action @(activeMenu == "XuatKho" ? "active" : "")" asp-controller="Kho" asp-action="XuatKho">
                        <i class="fa-solid fa-dolly me-2"></i> Xuất quầy / Xuất hủy
                    </a>
                    <a class="list-group-item list-group-item-action @(activeMenu == "KiemKe" ? "active" : "")" asp-controller="Kho" asp-action="KiemKe">
                        <i class="fa-solid fa-clipboard-check me-2"></i> Kiểm kê & Chênh lệch
                    </a>
                    <a class="list-group-item list-group-item-action @(activeMenu == "TheKho" ? "active" : "")" asp-controller="Kho" asp-action="TheKho">
                        <i class="fa-solid fa-book-bookmark me-2"></i> Sổ Thẻ kho truy vết
                    </a>
                }

                @if (currentUser?.MaVaiTro == "QUAN_LY" || currentUser?.MaVaiTro == "THU_NGAN")
                {
                    <div class="sidebar-category">BÁN HÀNG TẠI QUẦY</div>
                    <a class="list-group-item list-group-item-action bg-warning text-dark fw-bold mb-1" asp-controller="Pos" asp-action="Index">
                        <i class="fa-solid fa-cash-register me-2"></i> Màn hình Bán hàng POS
                    </a>
                    <a class="list-group-item list-group-item-action @(activeMenu == "CaIndex" ? "active" : "")" asp-controller="Ca" asp-action="Index">
                        <i class="fa-solid fa-clock-rotate-left me-2"></i> Quản lý Ca làm việc
                    </a>
                    <a class="list-group-item list-group-item-action @(activeMenu == "MoCa" ? "active" : "")" asp-controller="Ca" asp-action="MoCa">
                        <i class="fa-solid fa-door-open me-2"></i> Mở ca mới
                    </a>
                    <a class="list-group-item list-group-item-action @(activeMenu == "DongCa" ? "active" : "")" asp-controller="Ca" asp-action="DongCa">
                        <i class="fa-solid fa-door-closed me-2"></i> Đóng ca & Chốt tiền
                    </a>
                }
            </div>

            <div class="sidebar-footer p-3 text-muted border-top border-secondary mt-auto" style="font-size: 0.75rem;">
                <div>Phiên bản: <strong>1.0.0 Enterprise</strong></div>
                <div>Bảo mật: Bcrypt + ACID SQL</div>
            </div>
        </div>

        <!-- Page Content -->
        <div id="page-content-wrapper" class="w-100 d-flex flex-column min-vh-100">
            <!-- Navbar Header -->
            <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm px-3 py-2 sticky-top">
                <button class="btn btn-outline-secondary btn-sm me-3" id="sidebarToggle">
                    <i class="fa-solid fa-bars"></i>
                </button>

                <div class="d-flex align-items-center">
                    <span class="navbar-brand mb-0 h1 fs-6 fw-semibold text-primary">@ViewData["Title"]</span>
                    @if (currentUser?.CurrentMaCa.HasValue == true)
                    {
                        <span class="badge bg-success-subtle text-success border border-success ms-3 px-2 py-1">
                            <i class="fa-solid fa-circle text-success fa-beat me-1" style="font-size: 0.5rem;"></i>
                            Ca đang mở: #@currentUser.CurrentMaCa (@currentUser.CurrentTenQuay)
                        </span>
                    }
                    else if (currentUser?.MaVaiTro == "THU_NGAN")
                    {
                        <span class="badge bg-warning-subtle text-warning border border-warning ms-3 px-2 py-1">
                            <i class="fa-solid fa-triangle-exclamation me-1"></i> Chưa mở ca
                        </span>
                    }
                </div>

                <div class="ms-auto d-flex align-items-center">
                    <!-- Nút POS Nhanh cho thu ngân -->
                    @if (currentUser?.MaVaiTro == "THU_NGAN" || currentUser?.MaVaiTro == "QUAN_LY")
                    {
                        <a asp-controller="Pos" asp-action="Index" class="btn btn-warning btn-sm fw-bold me-3 shadow-sm">
                            <i class="fa-solid fa-cash-register me-1"></i> POS Thu Ngân
                        </a>
                    }

                    <!-- User Menu Dropdown -->
                    <div class="dropdown">
                        <a href="#" class="d-flex align-items-center text-dark text-decoration-none dropdown-toggle" id="dropdownUser" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="avatar bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 36px; height: 36px;">
                                <i class="fa-solid fa-user"></i>
                            </div>
                            <div class="d-none d-md-block text-start">
                                <div class="fw-bold small lh-1">@currentUser?.HoTen</div>
                                <span class="badge bg-secondary" style="font-size: 0.65rem;">@currentUser?.TenVaiTro</span>
                            </div>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="dropdownUser">
                            <li class="px-3 py-1">
                                <small class="text-muted">Tài khoản: <strong>@currentUser?.TenDangNhap</strong></small>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item" asp-controller="Auth" asp-action="DoiMatKhau">
                                    <i class="fa-solid fa-key me-2 text-primary"></i> Đổi mật khẩu
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item text-danger" asp-controller="Auth" asp-action="Logout">
                                    <i class="fa-solid fa-right-from-bracket me-2"></i> Đăng xuất
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>

            <!-- Main Body Container -->
            <main class="flex-grow-1 p-4 bg-light">
                <partial name="_NotificationPartial" />
                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="bg-white border-top py-2 px-4 text-muted small text-center text-md-start d-flex justify-content-between align-items-center">
                <span>&copy; @DateTime.Now.Year Cửa Hàng Tiện Lợi 24/7 - Hệ thống Quản trị & Bán lẻ</span>
                <span class="d-none d-md-inline text-secondary">Microsoft SQL Server • Chuẩn FEFO • An toàn giao dịch ACID</span>
            </footer>
        </div>
    </div>

    <!-- Bootstrap 5 Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Custom site js -->
    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
