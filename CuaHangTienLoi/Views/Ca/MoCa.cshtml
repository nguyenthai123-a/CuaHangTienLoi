@model CuaHangTienLoi.Models.MoCaViewModel
@{
    ViewData["Title"] = "Mở Ca Làm Việc";
    ViewBag.ActiveMenu = "MoCa";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 border-bottom">
                <div class="d-flex align-items-center">
                    <div class="bg-primary text-white rounded p-2 me-3">
                        <i class="fa-solid fa-door-open fa-lg"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0 text-primary">Khai Báo Mở Ca Làm Việc</h5>
                        <small class="text-muted">Mỗi quầy chỉ có duy nhất 1 ca được phép mở tại một thời điểm</small>
                    </div>
                </div>
            </div>

            <div class="card-body p-4">
                <form asp-action="MoCa" method="post">
                    @Html.AntiForgeryToken()

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger py-2 small mb-3">
                            @Html.ValidationSummary(false, "", new { @class = "mb-0 list-unstyled" })
                        </div>
                    }

                    <div class="mb-3">
                        <label asp-for="MaQuay" class="form-label fw-bold">Chọn Quầy Bán Hàng <span class="text-danger">*</span></label>
                        <select asp-for="MaQuay" class="form-select form-select-lg">
                            <option value="">-- Chọn quầy thu ngân --</option>
                            @foreach (var q in Model.DanhSachQuay)
                            {
                                <option value="@q.MaQuay">@q.TenQuay</option>
                            }
                        </select>
                        <span asp-validation-for="MaQuay" class="text-danger small"></span>
                        <div class="form-text small">Hệ thống áp dụng chỉ mục duy nhất: Mỗi quầy chỉ có thể có 1 ca đang hoạt động.</div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="TienDauCa" class="form-label fw-bold">Tiền Mặt Đầu Ca (VNĐ) <span class="text-danger">*</span></label>
                        <div class="input-group input-group-lg">
                            <input asp-for="TienDauCa" type="number" class="form-control font-monospace fw-bold text-end" step="1000" />
                            <span class="input-group-text">VNĐ</span>
                        </div>
                        <span asp-validation-for="TienDauCa" class="text-danger small"></span>
                        <div class="form-text small">Số tiền lẻ bàn giao trong hộc tiền để thối lại cho khách.</div>
                    </div>

                    <!-- Quick buttons -->
                    <div class="mb-4">
                        <small class="text-muted d-block mb-1">Gợi ý số tiền nhanh:</small>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="document.getElementById('TienDauCa').value = 500000">500.000đ</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="document.getElementById('TienDauCa').value = 1000000">1.000.000đ</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="document.getElementById('TienDauCa').value = 2000000">2.000.000đ</button>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary flex-grow-1 py-2 fw-bold">
                            <i class="fa-solid fa-check me-2"></i> Xác Nhận Mở Ca & Vào POS
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
