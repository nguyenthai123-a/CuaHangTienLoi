@{
    ViewData["Title"] = "Từ chối truy cập";
}
<div class="container text-center py-5">
    <div class="display-1 text-danger fw-bold"><i class="fa-solid fa-ban"></i></div>
    <h2 class="fw-bold mt-3">Từ chối quyền truy cập (403 Forbidden)</h2>
    <p class="text-muted mt-2">Tài khoản của bạn không có đủ thẩm quyền hoặc vai trò (RBAC) để truy cập chức năng này.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 py-2 mt-3 shadow-sm">
        <i class="fa-solid fa-arrow-left me-2"></i> Quay về trang chính
    </a>
</div>
